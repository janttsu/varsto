# Options of varsto-rendezvous as environment variables (see
# `varsto-rendezvous --help`). Everything here is optional; the values shown
# are the defaults except the host names, which are examples.
VARSTO_RV_LISTEN=127.0.0.1:8790
VARSTO_RV_UDP=0.0.0.0:3334
# What the internet reaches, when it is not the bound address (a firewall
# forwarding another port, NAT); comma-separated.
VARSTO_RV_PUBLIC_UDP_ADDR=rv.example.org:3334
# Relay: bytes per second per session and direction, over all sessions
# together, and per vault tag per hour (0: no cap; relay rate 0: no relay).
#VARSTO_RV_RELAY_RATE=4194304
#VARSTO_RV_RELAY_TOTAL_RATE=33554432
#VARSTO_RV_RELAY_TAG_BYTES=4294967296
#VARSTO_RV_MAX_RELAYS=1000
# Memory bounds of the registry.
#VARSTO_RV_MAX_SLOTS=200000
#VARSTO_RV_MAX_BYTES=1073741824
# error, warn, info or debug.
#VARSTO_RV_LOG=info
